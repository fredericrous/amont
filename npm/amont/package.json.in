{
  "name": "amont",
  "version": "__VERSION__",
  "description": "Opinionated git hooks that judge what you are committing, not what is on disk",
  "keywords": [
    "git",
    "git-hooks",
    "pre-commit",
    "pre-push",
    "hooks",
    "lint",
    "husky"
  ],
  "homepage": "https://github.com/fredericrous/amont#readme",
  "bugs": "https://github.com/fredericrous/amont/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredericrous/amont.git"
  },
  "license": "MIT",
  "author": "Frederic Rousseau",
  "type": "commonjs",
  "bin": {
    "amont": "bin/amont.js"
  },
  "files": [
    "bin/amont.js",
    "bin/native.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@amont-hooks/darwin-arm64": "__VERSION__",
    "@amont-hooks/darwin-x64": "__VERSION__",
    "@amont-hooks/linux-arm64-gnu": "__VERSION__",
    "@amont-hooks/linux-x64-gnu": "__VERSION__",
    "@amont-hooks/linux-x64-musl": "__VERSION__",
    "@amont-hooks/win32-x64": "__VERSION__"
  }
}
