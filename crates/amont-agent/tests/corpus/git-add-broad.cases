match	cd /Users/fredericrous/Developer/Perso/sre-wt-forgejo && git add -A && git status --porcelain && git commit -q -m "build(ci): add Forgejo Actions workflows" 2>&1 | tail -3; git log --oneline -1
match	cd /Users/fredericrous/Developer/Perso/sre-wt-forgejo && git add -A && git commit -q -m "test(tools): stub kube client in planner tools tests" 2>&1 | tail -2 && git push -q forgejo build/forgejo-actions && echo pushed && git log --oneline -1
match	cd /Users/fredericrous/Developer/Perso/ta-wt-forgejo && git add -A && git status --porcelain && git commit -q -m "build(ci): add Forgejo Actions workflows" 2>&1 | tail -2; git log --oneline -1
match	cd /Users/fredericrous/Developer/Perso/ta-wt-forgejo && python3 - <<'PY'\np='.forgejo/workflows/README.md'; s=open(p).read()\ns=s.replace('''# GitHub Actions\n\nCI/CD for the uv-workspace monorepo: one repo, 15 images. Everything runs on\nself-hosted ARC runners in the homelab cluster (`fredericrous/homelab`,\n`kubernetes/homelab/apps/arc/`), not on GitHub-hosted runners.\n\nTwo scale sets are involved:\n\n| `runs-on`          | What runs there                     | Mode                                  |\n| ---                | ---                                 | ---                                   |\n| `trade-agents`     | lint/type/test, integration, glue   | plain runner pod, jobs run in-container |\n| `trade-agents-ci`  | every `buildah bud`                 | `kubernetes-novolume`, one job pod per job |\n''','''# Forgejo Actions\n\nCI/CD for the uv-workspace monorepo: one repo, 15 images. Everything runs on\nself-hosted **Forgejo** runners in the homelab cluster (`fredericrous/homelab`,\n`kubernetes/homelab/services/forgejo-runners/`). This repo's authoritative\nforge is `git.daddyshome.fr`; GitHub Actions is disabled and `.github/workflows`\nis kept only as the migration's rollback reference.\n\nTwo runner classes are involved, both **host mode** (KEDA ScaledJob →\npod-per-job → `forgejo-runner one-job`). There is no docker daemon, no job\n`container:`, and no sudo — the toolchain IS the runner image\n(`services/forgejo-runner/Dockerfile`: uv, python 3.13, buildah, git/jq/yq).\n\n| `runs-on`          | What runs there                     | Mode                                       |\n| ---                | ---                                 | ---                                        |\n| `trade-agents`     | lint/type/test, glue                | host mode, one job pod per job             |\n| `trade-agents-ci`  | every `buildah bud`                 | host mode + root/vfs/chroot + NAS-zot conf |\n\n## Differences from the GitHub copy\n\n- **`integration` (testcontainers) is NOT ported** — no docker socket in host\n  mode. See the note at the end of `ci.yml`.\n- **The Camoufox / JA3 fingerprint tier is NOT ported** — needs `sudo apt-get`\n  and a `libgtk-3` the runner image does not ship. See the note in `ci.yml`.\n- **Images push to `git.daddyshome.fr/fredericrous/*`**, not ghcr.io.\n- **`UV_INDEX_FORGEJO_USERNAME`/`PASSWORD` are passed explicitly** from org\n  secrets; on ARC the equivalent Gitea vars were ambient in the runner pod env.\n- **`softprops/action-gh-release` → `code.forgejo.org/actions/forgejo-release`.**\n- The NAS-zot buildah layer cache (`192.168.1.43:5000`) is unchanged.\n''')\nopen(p,'w').write(s)\nPY\nhead -8 .forgejo/workflows/README.md; git add -A && git -c hook.skip=package-lock commit -q -m "docs(ci): retarget workflows README at Forgejo" 2>&1 | tail -2; git log --oneline -1
match	cd /Users/fredericrous/Developer/Perso/cv-wt-fjnpm && python3 - <<'PY'\np='.github/workflows/ci.yaml'; s=open(p).read()\ns=s.replace('''      - name: Install dependencies\n        run: |\n          echo "//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}" >> .npmrc\n          npm ci\n        env:\n          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}''',\n'''      - name: Install dependencies\n        # @fredericrous/* moved off GitHub Packages to the Forgejo npm registry.\n        # This repo is PUBLIC and stays on GitHub, but its private-scope auth\n        # has to follow the packages. The key carries the FULL registry path:\n        # Forgejo's npm endpoint is path-scoped and a host-only\n        # `//git.daddyshome.fr/:_authToken` is silently ignored (metadata\n        # resolves anonymously, the tarball fetch 401s).\n        run: |\n          echo "//git.daddyshome.fr/api/packages/fredericrous/npm/:_authToken=${NODE_AUTH_TOKEN}" >> .npmrc\n          npm ci\n        env:\n          NODE_AUTH_TOKEN: ${{ secrets.FORGEJO_PKG_READ_TOKEN }}''')\nopen(p,'w').write(s)\nimport yaml; yaml.safe_load(open(p)); print('ok')\nPY\ngrep -rn "npm.pkg.github" . --include='*.yaml' --include='Dockerfile' --include='.npmrc' 2>/dev/null | grep -v node_modules || echo "NO GHP REFS LEFT"\ngit add -A && git status --porcelain

# --- the rule must stay silent ---
nomatch	pkill -f "git push origin v0.33.66"
nomatch	echo "=== first tag ===" && git log --oneline | head
nomatch	cargo test --workspace
nomatch	git status --short
nomatch	git add -A packages/dbt-duckdb/
nomatch	git add -p
nomatch	git add src/main.rs src/lib.rs
nomatch	git add -- -A
nomatch	rg "git add -A" docs/
