match	cd /Users/fredericrous/Developer/Perso/tv-wt-forgejo && git add -A && git commit -q -m "build(ci): add Forgejo Actions workflows" 2>&1 | tail -4; git log --oneline -1
match	cd /Users/fredericrous/Developer/Perso/tv-wt-forgejo && git add -A && git status --porcelain && git commit -q -m "build(deps): relock lexical-multi on Forgejo npm" 2>&1 | tail -3 && git log --oneline -2
match	cd /Users/fredericrous/Developer/Perso/tv-wt-forgejo && git add -A && git commit -q -m "fix(ci): drop sudo apt step, use prebuilt sqlite3" 2>&1 | tail -2 && git push -q forgejo build/forgejo-actions && echo pushed && git log --oneline -1
match	cd /Users/fredericrous/Developer/Perso/kbv-wt-forgejo && git add -A && git status --porcelain && git -c hook.skip=package-lock commit -q -m "build(ci): add Forgejo Actions workflows" 2>&1 | tail -2; git log --oneline -1
match	SCRATCH=/private/tmp/claude-501/-Users-fredericrous-Developer-Perso/0e018add-fb1c-4dbe-a76b-09f488d6557f/scratchpad\nbash $SCRATCH/runs.sh ticket-vision 2; bash $SCRATCH/runs.sh kb-vision 2\ncd /Users/fredericrous/Developer/Perso/al-wt-forgejo && git add -A && git status --porcelain && git -c hook.skip=package-lock commit -q -m "build(ci): add Forgejo Actions workflows" 2>&1 | tail -2; git log --oneline -1
