# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- the rule should fire (from real transcripts) ---
match	cd /Users/fredericrous/Developer/Perso/sre-agent-wt-adr && git status --short && git add docs/design/delivery-agent.md && git commit -m "docs(design): integrate harness review into ADR" -m "Agent-harness review of the delivery-agent ADR, folded back into the\ndesign rather than appended:\n\n- Correct the kernel-reuse claim: platform-kernel ships engine/store/\n  policy/audit/LLM; recurrence gate, storm caps, KB-recall and the\n  diff-verifier are sre-agent patterns to PORT, not import (SS2/SS4).\n- Intake becomes pushed workflow_run webhooks (HMAC) with github-mcp as\n  enrichment; adds intake dedup claim {repo,workflow,job,sha,attempt,\n  signature}, storm caps, and a concrete 16KiB/200-line log bound (SS5).\n- CI logs treated as untrusted prompt-injection surface; quarantine +\n  schema-constrained classifier fallback that can never act (SS5a).\n- Tool contract pinned to the fleet idiom: never-raise ToolSpecs,\n  typed-outcome vs 5xx split, per-tool output caps (SS6); idempotent\n  retry keyed on GitHub run attempt, deterministic branches, bounded\n  watch-and-merge with ci_timeout (SS7).\n- DELIVERY_MODE ladder enforced by a kernel-primitive policy gate,\n  per-playbook autonomy caps, path-allowlist merge gate, per-repo retry\n  token bucket (SS9).\n- New Observability section (structlog, delivery_agent_* metrics, OTLP\n  HTTP :4318 never gRPC :4317) and Eval plan section (ci_classifier\n  stage, gate-safe cases, live-eval concurrency inherited) (SS12-13).\n- Rollout phases mapped 1:1 onto DELIVERY_MODE values (SS15); polling\n  intake recorded as a rejected alternative (SS16).\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" 2>&1 | tail -5
match	cd /Users/fredericrous/Developer/Perso/sre-agent-wt-adr && git add src/delivery_agent config/delivery_playbooks tests/test_delivery_agent_evidence.py tests/test_delivery_agent_main.py tests/test_delivery_agent_orchestrator.py tests/test_delivery_agent_playbooks.py tests/test_delivery_agent_policy.py tests/test_delivery_agent_redaction.py tests/test_delivery_agent_signatures.py tests/test_delivery_agent_state.py pyproject.toml && git commit -m "feat(delivery): CI reliability agent phases 1-2" -m "Implements the delivery-agent ADR's phase 1-2 slice as a sibling\nservice under src/delivery_agent (patch-agent's package shape):\n\n- main.py: FastAPI intake for workflow_run webhooks, GitHub HMAC\n  (X-Hub-Signature-256) over the raw body, /metrics ServiceMonitor\n  endpoint; process-lifetime store via lifespan.\n- orchestrator.py: procedural pipeline signal -> signature -> policy ->\n  action/report. Enrichment and LLM fallback are failure-soft; the one\n  write (rerun-failed-jobs) 502s so redelivery converges on the dedup\n  claim.\n- signatures.py: rules-first classifier over KB match regexes; schema-\n  constrained LLM fallback whose candidate can never trigger a write;\n  low-confidence degrades to unknown.\n- state.py: SQLite recurrence/retry store. Dedup claim on {repo,\n  workflow, job, head_sha, attempt, signature} -- attempt in the key so\n  a failed re-run is a new sighting, not a duplicate. Recurrence =\n  COUNT(DISTINCT head_sha).\n- policy.py: DELIVERY_MODE ladder on kernel Rule/decide_first_match;\n  security-sensitive deny, per-playbook autonomy caps, retry budgets +\n  per-repo hourly bucket; every deny carries an ADR SS11 reason code.\n- evidence.py: content-addressed CI evidence package with frozen\n  classifier_input and tail-biased 16KiB/200-line excerpt bounding.\n- redaction.py: ordered CI-secret patterns (npm/GH tokens, authToken,\n  basic-auth URLs, entropy heuristic) applied before freezing.\n- tools/github_ci.py: least-privilege REST client (jobs, job log,\n  rerun-failed-jobs).\n- config/delivery_playbooks/: the three ADR SS8 seed KB entries.\n- 9 test files cover the decision table end to end with fakes;\n  pyright strict now includes src/delivery_agent (clean from birth).\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" 2>&1 | tail -3
match	cd /Users/fredericrous/Developer/Perso/sre-agent-wt-adr && git add evals/runner.py evals/schema.py evals/thresholds.yaml evals/cases/ci_classifier_fallback.yaml tests/test_evals.py && git commit -m "feat(evals): ci_classifier fallback stage" -m "Wires delivery-agent's only LLM surface into the live eval harness\n(ADR SS13):\n\n- New ci_classifier stage: CiClassifierCase/Input/Assertion in\n  evals/schema.py, a _run_ci_classifier_case runner + deterministic\n  _check_ci_classifier grader (incl. signature_not_in for injection\n  resistance), --ci-classifier-model CLI arg.\n- Three gate-safe seed cases (runs 3, min_pass_rate 0.66): transient\n  registry 5xx, systemic type error, and a log-embedded injection that\n  must be classified as data. Fixtures are frozen excerpts = the\n  evidence package's classifier_input, so real incidents convert into\n  cases verbatim.\n- ci_classification tag gets an explicit 0.6 gate in thresholds.yaml\n  (don't silently inherit overall=0.85 for an unproven stage).\n- FakeLlm-based unit tests for the grader, the runner, and a guard\n  that shipped ci_classifier cases stay fast-PR-gate eligible.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" 2>&1 | tail -3 && git status --short && git log --oneline -4
match	cd /Users/fredericrous/Developer/Perso/sre-agent-wt-adr && git push origin chore/delivery-agent-adr 2>&1 | tail -6
match	cd /Users/fredericrous/Developer/Perso/sre-agent-wt-audit && git push origin chore/posture-audit-adr 2>&1 | tail -3 && git status --short --branch
match	git status --short && git add config/posture_invariants.yaml tests/test_posture_audit.py && git commit -m "🐛  fix(posture): use real KSM statefulset metric\n\nkube_statefulset_spec_replicas does not exist in kube-state-metrics\n(that naming is the Deployment family); the StatefulSet spec-replica\ngauge is kube_statefulset_replicas. First in-cluster sweep caught this\nexactly as designed: the presence guard returned empty and the check\ncame back 'blind' instead of green (finding\nstatefulset-single-replica/(presence)). With the real metric the\ninvariant has teeth — 10 of 11 StatefulSets currently run 1 replica.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" && git push -u origin fix/posture-sts-metric 2>&1 | tail -2 && gh pr create --title "🐛  fix(posture): use real KSM statefulset metric" --body "First in-cluster posture sweep (report-only soak, v0.8.53) returned \\`statefulset-single-replica\\` as **blind**: the presence guard found no \\`kube_statefulset_spec_replicas\\` series. That metric name doesn't exist in kube-state-metrics — the StatefulSet spec-replica gauge is \\`kube_statefulset_replicas\\` (verified against the cluster Prometheus: 11 series, 10 of them \\`== 1\\`).\n\nExactly the failure mode the blind semantics were built for (ADR §6): a wrong metric name reads as a \\`blind\\` finding, never as green. This fixes the catalog + test fixtures to the real metric.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)" 2>&1 | tail -1
match	uv run --no-sync ruff format tests/test_posture_audit.py && uv run --no-sync pytest tests/test_posture_audit.py -q -p no:cov 2>&1 | tail -1 && git add tests/test_posture_audit.py && git commit -m "🐛  fix(posture): use real KSM statefulset metric\n\nkube_statefulset_spec_replicas does not exist in kube-state-metrics\n(that naming is the Deployment family); the StatefulSet spec-replica\ngauge is kube_statefulset_replicas. First in-cluster sweep caught this\nexactly as designed: the presence guard returned empty and the check\ncame back 'blind' instead of green (finding\nstatefulset-single-replica/(presence)). With the real metric the\ninvariant has teeth — 10 of 11 StatefulSets currently run 1 replica.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" && git push -u origin fix/posture-sts-metric 2>&1 | tail -2
match	git -C /tmp/hl-main add kubernetes/homelab/apps/sre-agent/posture/posture_invariants.yaml && git -C /tmp/hl-main commit -m "🐛  fix(sre-agent): posture STS metric name\n\nRe-vendor the posture invariant catalog from sre-agent #119:\nkube_statefulset_spec_replicas does not exist in KSM — the real\ngauge is kube_statefulset_replicas. First sweep surfaced this as\na 'blind' finding instead of green, as designed.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" 2>&1 | tail -2 && git -C /tmp/hl-main push origin HEAD:main 2>&1 | tail -1
match	uv run --no-sync pytest tests/test_posture_audit.py -q -p no:cov 2>&1 | tail -1 && git add config/posture_exceptions.yaml && git commit -m "🔧  chore(posture): waive the 10 STS singletons\n\nFirst-soak triage of statefulset-single-replica: every current\nsingleton is an intentional homelab tradeoff (cache semantics,\nThanos-backed prometheus, licensing/session singletons, quorum\ncost). All 10 get owned, expiring waivers (2026-10-25) at info —\nre-justify or HA them on expiry; the cephfs-standby-present\ncritical stays OPEN and gets fixed in homelab, not waived.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" 2>&1 | tail -2 && git push -u origin fix/posture-waivers 2>&1 | tail -1 && gh pr create --title "🔧  chore(posture): waive the 10 STS singletons" --body "First-soak triage (report-only lane, v0.8.53): all 10 open \\`statefulset-single-replica\\` findings are intentional homelab singletons. Each gets an owned, expiring waiver (2026-10-25, downgrade to \\`info\\`) per the registry discipline — a green audit must mean \\"fixed or consciously waived with an expiry\\", and waivers rot on purpose.\n\nNotably NOT waived: \\`cephfs-standby-present\\` (critical) — that one is being fixed for real (\\`activeStandby: true\\` in homelab).\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)"
match	git -C /tmp/hl-main add kubernetes/homelab/rook-cluster/ceph-filesystem.yaml && git -C /tmp/hl-main commit -m "🐛  fix(rook): enable standby MDS for myfs\n\nactiveStandby: false left myfs with a single MDS — when it went\nlaggy the mon had nothing to fail over to and ALL CephFS metadata\nI/O stalled 13h while ceph -s stayed HEALTH_OK. Flip to true so a\nstandby-replay daemon shadows the active rank. Resolves the\nposture-audit critical finding cephfs-standby-present (homelab#303\nshipped the alert rules; this is the missing half).\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" 2>&1 | tail -2 && git -C /tmp/hl-main push origin HEAD:main 2>&1 | tail -1
match	git -C /tmp/hl-main add kubernetes/homelab/apps/sre-agent/posture/posture_exceptions.yaml && git -C /tmp/hl-main commit -m "🔧  chore(sre-agent): vendor posture waivers\n\nRe-vendor the exception registry from sre-agent #120: the 10\nsingle-replica StatefulSets get owned, expiring waivers\n(2026-10-25, downgraded to info). cephfs-standby-present was\nfixed for real (standby MDS), not waived.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" 2>&1 | tail -1 && git -C /tmp/hl-main push origin HEAD:main 2>&1 | tail -1
match	cd /Users/fredericrous/Developer/Perso/sre-agent-wt-adr && git fetch origin main -q && git log --oneline origin/main -3 && git tag v0.8.54 origin/main && git push origin v0.8.54 2>&1 | tail -1 && git rev-parse v0.8.54^{commit}
match	cd /tmp/hl-main && git status --short && git add kubernetes/homelab/apps/delivery-agent kubernetes/homelab/apps/delivery-agent.yaml kubernetes/homelab/apps/kustomization.yaml && git commit -m "✨  feat(delivery-agent): deploy observe phase\n\nShip the CI-reliability delivery-agent (sre-agent PR #117,\ndocs/design/delivery-agent.md) in rollout phase 1: same OCI image\nas sre-agent (0.8.54) with the delivery_agent entrypoint,\nDELIVERY_MODE=observe — classify + count, never act. Intake is\nGitHub workflow_run webhooks at delivery.daddyshome.fr/v1/intake\n(skip-mtls + Authelia bypass; HMAC-authenticated in-app, secret\ngenerated once in-cluster). Playbooks vendored from the sre-agent\nrepo. GitHub enrichment token is optional-by-design and not yet\nprovisioned: evidence is marked degraded until\nsecret/delivery-agent/github-token lands in Vault.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" 2>&1 | tail -3 && git push origin HEAD:main 2>&1 | tail -1
match	kubectl kustomize /tmp/hl-main/kubernetes/homelab/apps/delivery-agent > /dev/null && echo render-ok && cd /tmp/hl-main && git add kubernetes/homelab/apps/delivery-agent && git commit -m "🔧  chore(delivery-agent): wire GitHub enrichment token\n\nVault policy + k8s-auth role + SecretStore + ExternalSecret for\nsecret/delivery-agent/github-token (provisioned out-of-band,\npatch-agent pattern). The deployment already references\nDELIVERY_GITHUB_TOKEN optional:true — this ES is the switch that\nturns log-excerpt enrichment on; Reloader rolls the pod when the\nSecret lands. Classic repo-scope PAT for now; swap to a\nfine-grained actions:read PAT or GitHub App later.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>" 2>&1 | tail -2 && git push origin HEAD:main 2>&1 | tail -1

# --- the rule must stay silent ---
nomatch	pkill -f "git push origin v0.33.66"
