# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- the rule should fire (from real transcripts) ---
match	git stash pop && git status --short
match	cd /Users/fredericrous/Developer/Perso/website-builder-wt-xtab\ngit stash push -u -m "media-drop-fill-wip" 2>&1 | tail -2\ngit fetch origin feat/media-drag-to-grid -q\ngit checkout -B feat/media-drop-fill-icons-nav origin/feat/media-drag-to-grid 2>&1 | tail -2\ngit stash pop 2>&1 | tail -15
match	cd /Users/fredericrous/Developer/Perso/git-templates-wt-p10\ngit stash push -u -m "registry refactor" > /dev/null && echo "stashed the refactor"\ngh pr merge 26 --squash 2>&1|tail -1\ncd /Users/fredericrous/Developer/Perso/git-templates && git checkout -q main && git pull -q --ff-only && git log --oneline -1\ngit worktree add ../git-templates-wt-reg -b refactor/hook-registry origin/main 2>&1|tail -1\ncd ../git-templates-wt-p10 && git stash pop > /dev/null 2>&1 && cp -r src/registry.rs /tmp/registry.rs && cp src/main.rs /tmp/main.rs && echo "refactor files saved"
match	git stash pop && git diff --stat
match	git stash pop
match	cd /Users/fredericrous/Developer/Perso/trade-agents\ngit stash pop 2>&1 | tail -2\ngit status --short 2>/dev/null | head -3\necho "restored — trade-agents untouched"
match	f=$(find . -path "*node_modules/yjs/package.json" | head -1); python3 -c "import json;print('PRE-bump yjs:',json.load(open('$f'))['version'])"; git stash pop -q && pnpm install --silent >/dev/null 2>&1; f2=$(find . -path "*node_modules/yjs/package.json" | head -1); python3 -c "import json;print('POST-bump yjs:',json.load(open('$f2'))['version'])"
match	cd /Users/fredericrous/Developer/Perso/website-builder-wt-layout; git stash pop stash@{0} && grep -h '"@fredericrous/grid"' packages/editor/package.json apps/builder-webapp/package.json && pnpm install --silent >/dev/null 2>&1 && echo "installed:" && python3 -c "import json,glob;print(json.load(open(glob.glob('node_modules/.pnpm/@fredericrous+grid@*/node_modules/@fredericrous/grid/package.json')[0]))['version'])"
match	cd /Users/fredericrous/Developer/Perso/application-landscape\ngh pr merge 90 --squash --delete-branch 2>&1 | tail -2\ngit checkout main -q && git pull -q 2>&1 | tail -1\ngit checkout -b feat/local-first-leader -q\ngit stash pop 2>&1 | tail -3\necho "=== on $(git branch --show-current), status ==="\ngit status --porcelain
match	cd /Users/fredericrous/Developer/Perso/application-landscape\ngit stash push -u -m "c1-live-cursors" 2>&1 | tail -1\ngit checkout main -q\ngh pr merge 91 --squash --delete-branch 2>&1 | tail -2\ngit pull -q 2>&1 | tail -1\ngit checkout -b feat/local-first-cursors -q\ngit stash pop 2>&1 | tail -2\necho "=== on $(git branch --show-current) ==="\ngit status --porcelain
match	cd /Users/fredericrous/Developer/Perso/application-landscape\ngit checkout main -q\ngh pr merge 92 --squash --delete-branch 2>&1 | tail -2\ngit pull -q 2>&1 | tail -1\ngit checkout -b feat/local-first-migration -q\ngit stash pop 2>&1 | tail -2\necho "=== on $(git branch --show-current) ==="\ngit status --porcelain
match	cd /Users/fredericrous/Developer/Perso/application-landscape\ngit checkout main -q\ngh pr merge 94 --squash --delete-branch 2>&1 | tail -1\ngit pull -q 2>&1 | tail -1\ngit checkout -b perf/graph-hotfixes -q\ngit stash pop 2>&1 | tail -2\necho "=== on $(git branch --show-current) ==="\ngit status --porcelain
match	git stash pop 2>&1

# --- the rule must stay silent ---
nomatch	pkill -f "git push origin v0.33.66"
nomatch	echo "=== first tag ===" && git log --oneline | head
nomatch	cargo test --workspace
nomatch	git status --short
nomatch	git stash pop "stash@{2}"
nomatch	git stash apply refs/stash@{1}
nomatch	git stash list | grep wip
nomatch	git stash push -u -m "wip"
nomatch	git stash

# --- regressions: three defects found while asking whether this rule was fit
# --- to graduate to `deny` (2026-08-21). Each line failed before the fix.

# A. A bare `git stash` earlier on the line used to ABANDON the whole scan
#    (`ops.get(1)?` returned from examine), so the canonical save/restore
#    round-trip went unseen — the shape of a real incident that day.
match	git stash; git stash pop
match	git stash 2>/dev/null >/dev/null; yamllint x.yaml; git stash pop 2>/dev/null >/dev/null; echo restored
match	git stash && git stash pop

# B. The lexer ended a clause on `{`, truncating `stash@{2}` to `stash@`, so
#    the rule fired on the very remedy it recommends. Only the QUOTED form
#    escaped, which is an accident of lexing, not a difference in intent.
nomatch	git stash pop stash@{2}
nomatch	git stash apply stash@{1}
nomatch	git stash pop --index stash@{3}

# C. `names_a_stash` knew only `refs/stash`, so the per-worktree namespace that
#    exists precisely to avoid the shared ref still fired.
nomatch	git stash pop refs/wtstash/application-landscape
nomatch	git stash apply refs/wtstash/homelab

# The shared top of stack stays a fire however it is spelled: naming stash@{0}
# is not a choice of WHICH entry (see the reviewed worktree case above).
match	git stash pop refs/stash@{0}
match	git stash apply stash@{0}
